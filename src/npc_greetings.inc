static unsigned npc_voice_mix(unsigned v){
 v^=v>>16;v*=0x7feb352du;v^=v>>15;v*=0x846ca68bu;return v^(v>>16);
}
static int npc_greet_variant(unsigned identity,unsigned count){
 static const unsigned char steps[]={1,3,7,9,11,13,17,19,21,23,27,29,31,33,37,39,41,43,47,49};
 unsigned key=npc_voice_mix(identity^0x31997d3du);
 return (int)((key%50u+steps[(key>>16)%20u]*(count%50u))%50u);
}
/* Direct, canonical 50-line role deck (e.g. preview/diagnostic). */
static const char *npc_greet_text(int archetype,int variant){
 unsigned role=(unsigned)archetype<NPC_VOICE_ROLES?(unsigned)archetype:0u;
 int v=variant%NPC_VOICE_CYCLE;if(v<0)v+=NPC_VOICE_CYCLE;
 return v<NPC_VOICE_ROLE_DEALT?npc_voice_roles[role][v]:npc_voice_city[v-NPC_VOICE_ROLE_DEALT];
}
/* Player-facing version: no repeats in any actor's 50-visit cycle.
   Each stride is coprime to its pool size so neither subset duplicates. */
static const char *npc_greet_line(int archetype,unsigned identity,unsigned visits){
 static const unsigned char step36[]={1,5,7,11,13,17,19,23,25,29,31,35};
 unsigned role=(unsigned)archetype<NPC_VOICE_ROLES?(unsigned)archetype:0u;
 unsigned slot=(unsigned)npc_greet_variant(identity,visits);
 if(slot<NPC_VOICE_ROLE_DEALT){
  unsigned key=npc_voice_mix(identity^0xa68743dbu);
  return npc_voice_roles[role][(key%36u+slot*step36[(key>>16)%12u])%36u];
 }
 return npc_voice_city[npc_greet_variant(identity^0x9dd465acu,slot-NPC_VOICE_ROLE_DEALT)];
}
